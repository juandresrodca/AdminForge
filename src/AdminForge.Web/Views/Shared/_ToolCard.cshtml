@model ToolDescriptor

<a class="tool-card" href="@Model.Url">
    <span class="tool-card-icon">
        <svg width="18" height="18" aria-hidden="true" focusable="false"><use href="/icons/sprite.svg#@Model.Icon"></use></svg>
    </span>
    <span class="tool-card-name">@Model.Name</span>
    <span class="tool-card-desc">@Model.Description</span>
    <span class="tool-card-mode">@(Model.Compute == ComputeMode.ClientSide ? "in browser" : "server")</span>
</a>
